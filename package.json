{
  "name": "pokebowl-cove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "copy:atomic": "mkdir -p public && cp -r node_modules/@coveo/atomic-react/dist/assets node_modules/@coveo/atomic-react/dist/lang public/",
    "predev": "npm run copy:atomic",
    "prebuild": "npm run copy:atomic",
    "test:e2e": "playwright test",
    "eval": "node --env-file=.env evals/checkIndex.ts",
    "eval:reference": "node --env-file=.env evals/buildReference.ts",
    "eval:sets": "node --env-file=.env evals/buildEvalSets.ts",
    "eval:relevance": "node --env-file=.env evals/runRelevance.ts",
    "eval:prefix-benchmark": "node --env-file=.env evals/runPrefixBenchmark.ts",
    "eval:answers": "node --env-file=.env evals/runAnswers.ts",
    "eval:performance": "node --env-file=.env evals/runPerformance.ts",
    "eval:bundle": "node evals/runBundle.ts"
  },
  "dependencies": {
    "@coveo/atomic-react": "^3.11.50",
    "@coveo/headless": "^3.58.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cheerio": "^1.2.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
