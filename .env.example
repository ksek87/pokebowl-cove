# Copy this file to .env and fill in the values. Never commit .env.
# Variables starting with VITE_ are included in the browser bundle.
# Do not give any other secret a VITE_ prefix.

# ID of the Coveo organization that holds the index.
VITE_COVEO_ORGANIZATION_ID=

# Coveo API key limited to search. This is the only key the browser may use.
VITE_COVEO_SEARCH_API_KEY=
